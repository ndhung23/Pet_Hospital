datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PET_OWNER
  RECEPTIONIST
  VETERINARIAN
  NURSE
  CLINIC_MANAGER
}

enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  userName     String         @unique @db.VarChar(50)
  email        String         @unique @db.VarChar(100)
  passwordHash String         @db.VarChar(255)
  fullName     String         @db.VarChar(100)
  phone        String         @unique @db.VarChar(15)
  role         Role           @default(PET_OWNER)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  petOwner     PetOwner?
  employee     Employee?
  refreshTokens RefreshToken[]
  aiChatLogs   AIChatLog[]
  conductedRecords MedicalRecord[] @relation("VetMedicalRecords")
  orderedLabOrders LabOrder[]      @relation("VetLabOrders")
  performedLabOrders LabOrder[]    @relation("NurseLabOrders")

  @@map("users")
}

model PetOwner {
  userId    String   @id @db.Uuid
  address   String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pets Pet[]

  @@map("pet_owners")
}

model Employee {
  userId     String   @id @db.Uuid
  empCode    String   @unique @db.VarChar(30)
  department String?  @db.VarChar(100)
  salary     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employees")
}

model OtpToken {
  id         String     @id @default(uuid()) @db.Uuid
  email      String     @db.VarChar(100)
  purpose    OtpPurpose
  codeHash   String     @db.VarChar(255)
  payload    Json?
  expiresAt  DateTime
  attempts   Int        @default(0)
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([email, purpose])
  @@map("otp_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Pet {
  id             String          @id @default(uuid()) @db.Uuid
  ownerId        String          @db.Uuid
  name           String          @db.VarChar(100)
  species        String          @db.VarChar(50)
  breed          String?         @db.VarChar(100)
  dob            DateTime?
  gender         String?         @db.VarChar(20)
  weight         Float?
  history        String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  owner          PetOwner        @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
  medicalRecords MedicalRecord[]
  labOrders      LabOrder[]
  aiChatLogs     AIChatLog[]

  @@index([ownerId])
  @@map("pets")
}

model MedicalRecord {
  id            String         @id @default(uuid()) @db.Uuid
  petId         String         @db.Uuid
  vetId         String?        @db.Uuid
  weight        Float?
  temperature   Float?
  heartRate     Int?
  symptoms      String?        @db.Text
  diagnosis     String         @db.Text
  treatmentPlan String         @db.Text
  status        String         @default("COMPLETED") @db.VarChar(50)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  pet           Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  vet           User?          @relation("VetMedicalRecords", fields: [vetId], references: [id], onDelete: SetNull)
  labOrders     LabOrder[]
  prescriptions Prescription[]

  @@index([petId])
  @@index([vetId])
  @@map("medical_records")
}

model LabOrder {
  id             String    @id @default(uuid()) @db.Uuid
  orderCode      String    @unique @db.VarChar(50)
  recordId       String    @db.Uuid
  petId          String    @db.Uuid
  vetId          String?   @db.Uuid
  nurseId        String?   @db.Uuid
  testType       String    @db.VarChar(100)
  urgency        String    @default("ROUTINE") @db.VarChar(20)
  requestNote    String?   @db.Text
  status         String    @default("PENDING") @db.VarChar(30)
  resultValues   Json?
  resultSummary  String?   @db.Text
  resultImageUrl String?   @db.Text
  sampleTakenAt  DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  medicalRecord  MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  pet            Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  vet            User?         @relation("VetLabOrders", fields: [vetId], references: [id], onDelete: SetNull)
  nurse          User?         @relation("NurseLabOrders", fields: [nurseId], references: [id], onDelete: SetNull)

  @@index([recordId])
  @@index([petId])
  @@index([status, urgency])
  @@map("lab_orders")
}

model Prescription {
  id           String   @id @default(uuid()) @db.Uuid
  recordId     String   @db.Uuid
  medicineName String   @db.VarChar(150)
  dosage       String   @db.VarChar(100)
  quantity     Int      @default(1)
  unit         String?  @db.VarChar(50)
  duration     String?  @db.VarChar(50)
  instructions String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  medicalRecord MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
  @@map("prescriptions")
}

model AIChatLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  petId       String?  @db.Uuid
  questionRaw String   @db.Text
  aiResponse  String   @db.Text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pet  Pet? @relation(fields: [petId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("ai_chat_logs")
}
